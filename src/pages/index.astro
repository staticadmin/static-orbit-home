---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Static Orbit</h1>
<p>
	Static Orbit is a small independent development studio. We design, build and
	look after websites and digital tools, and take early-stage ideas from concept
	to something real.
</p>

<h2>What we do</h2>
<ul>
	<li>Website and web app development</li>
	<li>Hosting, maintenance and ongoing support</li>
	<li>Consultancy and technical advisory</li>
	<li>Concept and prototype development</li>
</ul>

<h2>Get in touch</h2>
<p>
	For enquiries, email
	<a href="mailto:admin@static-orbit.co.uk">admin@static-orbit.co.uk</a>.
</p>

<p><em>Full site coming soon.</em></p>
		</main>
		<Footer />
	</body>
</html>
